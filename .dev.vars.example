# Workerのローカル設定。基盤実装後に .dev.vars へコピー。
# local-mockの設定。対応表: docs/ARCHITECTURE.md#mode-matrix
# APP_ENV: development/staging/production、DATA_MODE: mock/live/sample、AI_MODE: mock/live
# GENERATION_ENABLEDは実AI呼び出しだけを許可する。モック表示ではfalseのまま。
# 秘密情報（APIキーなど）をcommitしない。
APP_ENV="development"
DATA_MODE="mock"
AI_MODE="mock"
GENERATION_ENABLED="false"
# Worker用Supabase接続設定。Publishable keyは公開可能なキーで、secret keyをVITE_*へ入れない。
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Worker専用秘密情報。サーバーRPC clientのみで使い、.env.localへコピーせず値をコミットしない。
SUPABASE_SECRET_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_ALLOWED_HOSTNAMES="localhost,127.0.0.1"
# Workerだけが使うOpenAI APIキー。VITE_*へ設定しない。
OPENAI_API_KEY=""
# 上限・モデルprofileはprivate.generation_policyで管理。承認までは0/disabled。
