# Workerのローカル設定。基盤実装後に .dev.vars へコピー。
# local-mockの設定。対応表: docs/ARCHITECTURE.md#mode-matrix
# APP_ENV: development/staging/production、DATA_MODE: mock/live/sample、AI_MODE: mock/live
# GENERATION_ENABLEDは実AI呼び出しだけを許可する。モック表示ではfalseのまま。
# 秘密情報（APIキーなど）をcommitしない。
APP_ENV="development"
DATA_MODE="mock"
AI_MODE="mock"
GENERATION_ENABLED="false"
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
TURNSTILE_SECRET_KEY=""
# 実モデルを選んだ場合のみ使う。Workers AIはbindingを別途設定する。
GEMINI_API_KEY=""
# 上限・モデルprofileはprivate.generation_policyで管理。承認までは0/disabled。
