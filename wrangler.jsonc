{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manga-nikki",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_ENV": "production",
    "DATA_MODE": "sample",
    "AI_MODE": "mock",
    "GENERATION_ENABLED": "false",
  },
  "env": {
    "local-connected": {
      "name": "manga-nikki-local-connected",
      "vars": {
        "APP_ENV": "staging",
        "DATA_MODE": "live",
        "AI_MODE": "mock",
        "GENERATION_ENABLED": "false",
      },
      "assets": {
        "directory": "dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "queues": {
        "producers": [
          {
            "binding": "GENERATION_QUEUE",
            "queue": "manga-nikki-generations-local-connected",
          },
        ],
        "consumers": [
          {
            "queue": "manga-nikki-generations-local-connected",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_retries": 3,
            "max_concurrency": 2,
          },
        ],
      },
      "triggers": { "crons": ["* * * * *", "0 15 * * *"] },
    },
    "staging": {
      "workers_dev": true,
      "preview_urls": false,
      "triggers": { "crons": [] },
      "vars": {
        "APP_ENV": "staging",
        "DATA_MODE": "sample",
        "AI_MODE": "mock",
        "GENERATION_ENABLED": "false",
      },
      "assets": {
        "directory": "dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
    },
    "demo": {
      "name": "manga-nikki-demo",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "staging",
        "DATA_MODE": "live",
        "AI_MODE": "live",
        "GENERATION_ENABLED": "false",
      },
      "assets": {
        "directory": "dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "queues": {
        "producers": [
          {
            "binding": "GENERATION_QUEUE",
            "queue": "manga-nikki-generations-demo",
          },
        ],
        "consumers": [
          {
            "queue": "manga-nikki-generations-demo",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_retries": 3,
            "max_concurrency": 2,
          },
        ],
      },
      "triggers": { "crons": ["* * * * *", "0 15 * * *"] },
    },
    "production": {
      "triggers": { "crons": ["0 15 * * *"] },
      "vars": {
        "APP_ENV": "production",
        "DATA_MODE": "sample",
        "AI_MODE": "mock",
        "GENERATION_ENABLED": "false",
      },
      "assets": {
        "directory": "dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
    },
  },
  "observability": { "enabled": false },
}
