{
  "name": "manga-nikki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:connected": "node scripts/dev-local-connected.mjs",
    "lint": "oxlint --deny-warnings && oxfmt --check .",
    "format": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "pnpm build && playwright test --config playwright.pwa.config.ts",
    "build": "vite build && node scripts/check-pwa-build.mjs",
    "build:staging": "node scripts/build-environment.mjs staging",
    "build:production": "node scripts/build-environment.mjs production",
    "build:demo": "node scripts/build-environment.mjs demo",
    "test:release-environment": "node scripts/test-release-environment.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.14",
    "openai": "^7.50.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^4.1.12",
    "workbox-window": "7.4.1",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.11.2"
}
